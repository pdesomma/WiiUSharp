<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Version>0.7.0</Version>
    <Title>WiiUSharp.Imaging</Title>
    <Description>Turns PNG, JPEG, BMP, WebP or TGA sources into the exact TGA images a Wii U title needs (icon, boot screens, logo). Cross-platform via SkiaSharp.</Description>
    <PackageReleaseNotes>0.7.0: version aligned; no changes.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="3.119.0" />
    <PackageReference Include="TargaSharp" Version="0.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WiiUSharp\WiiUSharp.csproj" />
  </ItemGroup>

</Project>
