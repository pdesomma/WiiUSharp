<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Version>0.1.0</Version>
    <Title>WiiUSharp</Title>
    <Description>.NET library for Wii U title concepts: title IDs, product codes, regions, per-language names, and the image and boot-sound formats a title ships with.</Description>
    <PackageReleaseNotes>0.1.0: initial release.</PackageReleaseNotes>
    <GeneratePackageOnBuild Condition="'$(Configuration)' == 'Release'">true</GeneratePackageOnBuild>
  </PropertyGroup>

</Project>
